{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "noEmitOnError": true,
        "skipLibCheck": false,
        "types": [],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noUncheckedSideEffectImports": true
    },
    "files": [
        "tests/TypeScript/public-api.tsx"
    ],
    "include": [
        "dist/**/*.d.ts"
    ]
}
