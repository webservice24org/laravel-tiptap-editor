{
    "name": "microweb/laravel-tiptap-editor",
    "description": "A reusable Tiptap rich text editor package for Laravel and React applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "react",
        "tiptap",
        "editor",
        "typescript",
        "rich-text-editor"
    ],
    "autoload": {
        "psr-4": {
            "MicroWeb\\TiptapEditor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MicroWeb\\TiptapEditor\\TiptapEditorServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-libxml": "*",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.50 || ^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "MicroWeb\\TiptapEditor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:12": [
            "@php tools/assert-test-stack.php 12",
            "@test"
        ],
        "test:13": [
            "@php tools/assert-test-stack.php 13",
            "@test"
        ]
    }
}
