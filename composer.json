{
    "name": "microweb/laravel-tiptap-editor",
    "description": "A reusable Tiptap rich text editor package for Laravel and React applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "react",
        "tiptap",
        "editor",
        "typescript",
        "rich-text-editor"
    ],
    "autoload": {
        "psr-4": {
            "MicroWeb\\TiptapEditor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MicroWeb\\TiptapEditor\\TiptapEditorServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0"
    }
}
