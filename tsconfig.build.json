{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "declarationMap": false,
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "rootDir": "resources/js",
        "noEmitOnError": true
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.d.ts"
    ],
    "exclude": [
        "vite.config.ts",
        "resources/js/Index.tsx"
    ]
}
