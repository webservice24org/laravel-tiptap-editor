{
    "name": "@microweb/laravel-tiptap-editor",
    "version": "1.0.0",
    "description": "Reusable Tiptap rich text editor for Laravel and React applications.",
    "license": "MIT",
    "type": "module",
    "sideEffects": [
        "./dist/editor.css"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./editor.css": "./dist/editor.css"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && vite build && npm run build:types && npm run check:types && npm run check:bundle",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build",
        "check:runtime": "node tools/check-node-runtime.cjs",
        "test:runtime": "node --test tools/check-node-runtime.test.cjs",
        "prebuild": "node tools/check-node-runtime.cjs",
        "pretypecheck": "node tools/check-node-runtime.cjs",
        "build:types": "tsc -p tsconfig.build.json && node tools/declaration-contract.cjs normalize",
        "prebuild:types": "node tools/check-node-runtime.cjs",
        "check:types": "node tools/declaration-contract.cjs verify && tsc -p tsconfig.declarations.json && tsc -p tsconfig.declarations.nodenext.json",
        "test:types": "node --test tools/declaration-contract.test.cjs",
        "check:bundle": "node --check dist/index.js && node tools/bundle-contract.cjs",
        "test:bundle": "node --test tools/bundle-contract.test.cjs",
        "test:consumer:contract": "node --test tools/consumer-contract.test.cjs",
        "test:consumer": "node tools/run-consumer-compatibility.cjs",
        "test:archive": "node --test tools/archive-contract.test.cjs",
        "pack:verified": "node tools/run-archive-compatibility.cjs pack",
        "check:archive": "node tools/run-archive-compatibility.cjs verify",
        "test:toolbar": "node --test tools/toolbar-contract.test.cjs",
        "check:toolbar": "node tools/toolbar-contract.cjs"
    },
    "peerDependencies": {
        "@tiptap/core": "^3.32.0",
        "@tiptap/extension-subscript": "^3.32.0",
        "@tiptap/extension-superscript": "^3.32.0",
        "@tiptap/extension-table": "^3.32.0",
        "@tiptap/extension-text-align": "^3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/react": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "dependencies": {
        "dompurify": "3.5.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^5.0.0",
        "rimraf": "6.1.4",
        "typescript": "^5.7.0",
        "vite": "7.3.8"
    },
    "engines": {
        "node": "^22.20.0 || ^24.12.0 || ^26.0.0",
        "npm": ">=10.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
