{
    "name": "@microweb/laravel-tiptap-editor",
    "version": "1.0.0",
    "description": "Reusable Tiptap rich text editor for Laravel and React applications.",
    "license": "MIT",
    "type": "module",
    "sideEffects": [
        "./dist/editor.css"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./editor.css": "./dist/editor.css"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "@tiptap/core": "^3.0.0",
        "@tiptap/extension-subscript": "^3.0.0",
        "@tiptap/extension-superscript": "^3.0.0",
        "@tiptap/extension-table": "^3.0.0",
        "@tiptap/extension-text-align": "^3.0.0",
        "@tiptap/react": "^3.0.0",
        "@tiptap/starter-kit": "^3.0.0",
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "dependencies": {
        "dompurify": "^3.2.6"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^5.0.0",
        "rimraf": "^6.0.0",
        "typescript": "^5.7.0",
        "vite": "^7.0.0"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
